root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 2

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Public API surface is tracked by Microsoft.CodeAnalysis.PublicApiAnalyzers
# (PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt in src/MDator and
# src/MDator.Abstractions). RS0026 flags overloads that differ only by optional
# parameters; MDator mirrors MediatR's configuration API, which has them by
# design, so the rule is off.
[src/MDator*/**.cs]
dotnet_diagnostic.RS0026.severity = none
